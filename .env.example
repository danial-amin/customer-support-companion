# ============================================
# Customer Support AI - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# OpenAI Configuration (Required)
# ============================================
OPENAI_API_KEY=your-openai-api-key-here

# ============================================
# Pinecone Configuration (Required for RAG)
# ============================================
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=customer-support

# ============================================
# Database Configuration (Required for SQL Agent)
# ============================================
# Option 1: Full connection string (recommended for docker-compose)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/customersupport

# Option 2: Individual settings (used if DATABASE_URL not set)
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=customersupport
# DB_USER=postgres
# DB_PASSWORD=postgres

# For local development (not using docker-compose), use:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/customersupport
# Or
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=customersupport
# DB_USER=postgres
# DB_PASSWORD=postgres

# ============================================
# Security Configuration
# ============================================
# Generate a strong secret key with: openssl rand -hex 32
SECRET_KEY=change-me-generate-strong-secret-key-min-32-characters

# JWT Token Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY_HEADER=X-API-Key

# ============================================
# CORS Configuration
# ============================================
# JSON array format for allowed origins
# For local development:
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost"]
# For production, replace with your domain:
# CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# ============================================
# Application Settings
# ============================================
API_V1_PREFIX=/api/v1
PROJECT_NAME=Customer Support AI
VERSION=1.0.0

# ============================================
# LLM Model Configuration
# ============================================
MODEL_NAME=gpt-4
TEMPERATURE=0.7
MAX_TOKENS=2000

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO

# ============================================
# Frontend Configuration (Optional)
# ============================================
# VITE_API_URL=http://localhost:8000
# VITE_API_KEY=your-api-key-here
